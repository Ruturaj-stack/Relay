# RELAY — environment configuration
#
# Leave these empty to run the fully local demo (default).
# The app never reports a hosted connection unless both values are set.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: public base URL used when generating handoff QR links.
# Defaults to window.location.origin at runtime.
# VITE_PUBLIC_APP_URL=https://relay.example.com
